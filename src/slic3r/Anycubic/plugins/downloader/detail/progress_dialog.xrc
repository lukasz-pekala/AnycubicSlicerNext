<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
  <object class="wxPanel" name="DownloadProgress">
    <size>500,111</size>
    <style>wxTAB_TRAVERSAL</style>
    <object class="wxBoxSizer" name="bSizer1">
      <orient>wxVERTICAL</orient>
      <object class="sizeritem">
        <flag>wxTOP|wxEXPAND|wxALIGN_CENTER_HORIZONTAL</flag>
        <border>0</border>
        <option>0</option>
        <object class="wxBoxSizer" name="bSizer2">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <flag>wxEXPAND</flag>
            <border>5</border>
            <option>1</option>
            <size>0,0</size>
          </object>
          <object class="sizeritem">
            <flag>wxALIGN_CENTER|wxALL</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxStaticText" name="label">
              <label></label>
              <wrap>-1</wrap>
            </object>
          </object>
          <object class="spacer">
            <flag>wxEXPAND</flag>
            <border>5</border>
            <option>1</option>
            <size>0,0</size>
          </object>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxALL|wxEXPAND</flag>
        <border>10</border>
        <option>0</option>
        <object class="wxGauge" name="progress">
          <size>-1,30</size>
          <style>wxBORDER_THEME</style>
          <range>100</range>
          <value>0</value>
        </object>
      </object>
      <object class="sizeritem">
        <flag>wxEXPAND</flag>
        <border>0</border>
        <option>1</option>
        <object class="wxBoxSizer" name="bSizer3">
          <orient>wxHORIZONTAL</orient>
          <object class="spacer">
            <flag>wxEXPAND</flag>
            <border>5</border>
            <option>1</option>
            <size>0,0</size>
          </object>
          <object class="sizeritem">
            <flag>wxALIGN_BOTTOM|wxALL</flag>
            <border>5</border>
            <option>0</option>
            <object class="wxButton" name="cancel">
              <label>Cancel</label>
              <default>0</default>
              <auth_needed>0</auth_needed>
              <markup>0</markup>
              <bitmap />
            </object>
          </object>
        </object>
      </object>
    </object>
  </object>
</resource>